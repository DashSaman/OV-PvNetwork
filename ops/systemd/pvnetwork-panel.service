[Unit]
Description=PVNetwork Panel
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pvnetwork-panel
ExecStart=/opt/pvnetwork-panel/.venv/bin/python3 /opt/pvnetwork-panel/main.py
Restart=always
RestartSec=3s
TimeoutStopSec=20s
KillMode=mixed
User=root

[Install]
WantedBy=multi-user.target
