# Copy to /etc/pvnetwork-panel/firewall.env with mode 0600 only after
# inventorying every required listener on the target host.
PVNETWORK_FIREWALL_TCP_PORTS=22,80,443
PVNETWORK_FIREWALL_UDP_PORTS=1194
PVNETWORK_FIREWALL_ROLLBACK_AFTER=180
PVNETWORK_FIREWALL_PUBLIC_HEALTH_URL=https://vpn.example.com/panel/
PVNETWORK_FIREWALL_REQUIRED_SERVICES="pvnetwork-panel.service nginx.service ssh.service openvpn-server@server.service"
