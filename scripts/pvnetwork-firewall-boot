#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="${PVNETWORK_FIREWALL_CONFIG:-/etc/pvnetwork-panel/firewall.env}"
HARDEN="${PVNETWORK_FIREWALL_TOOL:-/usr/local/sbin/pvnetwork-firewall-hardening}"
PANEL_ENV="${PVNETWORK_PANEL_ENV:-/opt/pvnetwork-panel/.env}"

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo 'root required' >&2; exit 1; }
[[ -r "$CONFIG" ]] || { echo "firewall config missing: $CONFIG" >&2; exit 2; }
# shellcheck disable=SC1090
. "$CONFIG"

TCP_PORTS="${PVNETWORK_FIREWALL_TCP_PORTS:-}"
UDP_PORTS="${PVNETWORK_FIREWALL_UDP_PORTS:-}"
ROLLBACK_AFTER="${PVNETWORK_FIREWALL_ROLLBACK_AFTER:-180}"
PUBLIC_HEALTH_URL="${PVNETWORK_FIREWALL_PUBLIC_HEALTH_URL:-}"
REQUIRED_SERVICES="${PVNETWORK_FIREWALL_REQUIRED_SERVICES:-pvnetwork-panel.service nginx.service ssh.service}"

[[ -n "$TCP_PORTS$UDP_PORTS" ]] || {
  echo 'firewall allowlist is empty' >&2
  exit 3
}

OUTPUT="$($HARDEN --apply --tcp "$TCP_PORTS" --udp "$UDP_PORTS" --rollback-after "$ROLLBACK_AFTER")"
printf '%s\n' "$OUTPUT"
BACKUP="$(printf '%s\n' "$OUTPUT" | awk -F= '$1=="rollback"{print $2}' | tail -1)"
[[ -n "$BACKUP" ]] || { echo 'rollback path missing' >&2; exit 4; }

PORT="$(awk -F= '$1=="PORT"{gsub(/[[:space:]\r]/,"",$2); print $2}' "$PANEL_ENV" | tail -1)"
PORT="${PORT:-19000}"

# PVN-1001: ssh is socket-activated on Ubuntu 24.04 (ssh.service stays inactive
# until the first connection), so requiring ssh.service at boot always failed.
# Accept the socket-activated unit / distro aliases as satisfying the check.
service_active() {
  local svc="$1"
  systemctl is-active --quiet "$svc" && return 0
  case "$svc" in
    ssh.service)
      systemctl is-active --quiet ssh.socket && return 0
      systemctl is-active --quiet sshd.service && return 0
      ;;
  esac
  return 1
}

for service in $REQUIRED_SERVICES; do
  service_active "$service" || {
    echo "required service is not active: $service" >&2
    exit 5
  }
done

curl -fsS --connect-timeout 2 --max-time 5 \
  "http://127.0.0.1:${PORT}/healthz" >/dev/null || {
  echo 'local panel health failed after firewall apply' >&2
  exit 6
}

if [[ -n "$PUBLIC_HEALTH_URL" ]]; then
  curl -fkSs --connect-timeout 3 --max-time 10 \
    "$PUBLIC_HEALTH_URL" >/dev/null || {
    echo 'public health failed after firewall apply' >&2
    exit 7
  }
fi

"$HARDEN" --confirm "$BACKUP"
echo "PVNETWORK_FIREWALL_BOOT=PASS rollback=$BACKUP"
